<ui:FluentWindow x:Class="NeteaseMusicCloudMatch.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NeteaseMusicCloudMatch.App.Views"
                 mc:Ignorable="d"
                 Title="云盘匹配"
                 Icon="Assets/AppIcon.ico"
                 Width="1220"
                 Height="800"
                 MinWidth="1060"
                 MinHeight="680"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="云盘匹配" Padding="12,0" />

        <Grid Grid.Row="1">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:LoginView DataContext="{Binding Login}" />
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="26,8,26,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="{DynamicResource SurfaceAltBrush}"
                                ClipToBounds="True">
                            <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UserIdText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource NavigationSurfaceBrush}"
                            CornerRadius="13"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="云盘" Command="{Binding ShowCloudCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource TopNavigationButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavigation}" Value="云盘">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="日志" Command="{Binding ShowLogCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource TopNavigationButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavigation}" Value="操作日志">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="设置" Command="{Binding ShowSettingsCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource TopNavigationButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavigation}" Value="设置">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="13,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="云盘容量" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" />
                                <TextBlock Text="{Binding CloudDrive.CapacityText}" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ui:Button Content="刷新" Command="{Binding CloudDrive.RefreshCommand}" Appearance="Secondary" Margin="0,0,4,0" />
                        <ui:Button Content="退出" Command="{Binding LogoutCommand}" Appearance="Transparent" />
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Background="#66000000" Panel.ZIndex="80">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Style="{StaticResource CardBorder}" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="210" Height="3" />
                    <TextBlock Text="正在恢复登录状态…" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <ui:ContentDialogHost x:Name="RootDialogHost"
                              Grid.RowSpan="2"
                              IsDisableSiblingsEnabled="True"
                              Panel.ZIndex="100" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="24"
                              Panel.ZIndex="120" />
    </Grid>
</ui:FluentWindow>
