<UserControl x:Class="NeteaseMusicCloudMatch.App.Views.CloudDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:NeteaseMusicCloudMatch.App.Views">
    <Grid Margin="26,16,26,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="620" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="音乐云盘" FontSize="24" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10" Padding="10,4" Margin="11,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SongCountText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="选择歌曲，在右侧核对并纠正曲库关联"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索当前页的歌曲、歌手、专辑或文件名"
                             Padding="13,8,38,8" />
                    <TextBlock Text="搜索当前页"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="14,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="⌕" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="18" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding SongsView}"
                          SelectedItem="{Binding SelectedSong}"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="歌曲" Width="2*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8"
                                                Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artists}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="专辑" Binding="{Binding Album}" Width="*" MinWidth="130" />
                        <DataGridTextColumn Header="云盘 ID" Binding="{Binding SongId}" Width="98" />
                        <DataGridTextColumn Header="大小" Binding="{Binding FileSize}" Width="78" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="3" Margin="4,12,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="上一页" Command="{Binding PreviousPageCommand}" Appearance="Transparent" />
                    <Border Background="{DynamicResource NavigationSurfaceBrush}" CornerRadius="11" Padding="10,4" Margin="4,0">
                        <TextBlock Text="{Binding CurrentPage, StringFormat=第 {0} 页}" VerticalAlignment="Center" FontSize="10" />
                    </Border>
                    <ui:Button Content="下一页" Command="{Binding NextPageCommand}" Appearance="Transparent" />
                </StackPanel>
            </Grid>
        </Grid>

        <views:MatchPanel Grid.Column="2" DataContext="{Binding Match}" />
    </Grid>
</UserControl>
