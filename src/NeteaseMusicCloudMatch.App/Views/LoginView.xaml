<UserControl x:Class="NeteaseMusicCloudMatch.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-210,-250,0,0" Fill="{DynamicResource AccentSoftBrush}" IsHitTestVisible="False" />
        <Grid Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="4,0,4,22">
                <Image Source="/NeteaseMusicCloudMatch.App;component/Assets/AppIcon.png"
                       Width="58" Height="58" HorizontalAlignment="Left" />
                <TextBlock Text="连接网易云音乐" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="登录后即可查看并纠正你自己的云盘歌曲信息"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="粘贴完整 Cookie" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="从网页版请求标头中复制" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="打开网易云网页版"
                                   Command="{Binding OpenNeteaseWebsiteCommand}" Appearance="Transparent" />
                    </Grid>

                    <TextBox Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="120" MaxHeight="170"
                             Margin="0,14,0,0" Padding="12"
                             FontFamily="Consolas" FontSize="11"
                             SpellCheck.IsEnabled="False" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="记住登录状态（DPAPI 加密）" IsChecked="{Binding RememberLogin}" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="清空" Command="{Binding ClearCookieCommand}" Appearance="Transparent" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="11,9" Margin="0,14,0,0">
                        <TextBlock Text="凭证仅发送到配置允许的网易云官方域名，不会写入日志。"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MinHeight="20" Margin="2,12,2,8" />
                    <ui:Button Content="Cookie 登录" Command="{Binding LoginCommand}" Appearance="Primary"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
