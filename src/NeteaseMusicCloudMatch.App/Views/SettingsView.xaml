<UserControl x:Class="NeteaseMusicCloudMatch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Center">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="外观、连接信息与项目说明"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,6,0,22" />

            <Border Style="{StaticResource CardBorder}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="选择后立即应用，并在下次启动时恢复。"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource NavigationSurfaceBrush}"
                            CornerRadius="14" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="跟随系统" Command="{Binding UseSystemThemeCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource ThemeSelectorButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="浅色" Command="{Binding UseLightThemeCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource ThemeSelectorButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="深色" Command="{Binding UseDarkThemeCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource ThemeSelectorButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="连接与诊断" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="接口地址由网络层集中管理；应用不会失败后随机切换 Host。"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" Margin="0,5,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="读取接口" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" />
                                <TextBlock Text="{Binding ReadApiHost}" FontFamily="Consolas" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="匹配接口" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" />
                                <TextBlock Text="{Binding MatchApiHost}" FontFamily="Consolas" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志目录" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LogDirectory}" FontFamily="Consolas"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,4,18,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="打开目录"
                                   Command="{Binding OpenLogDirectoryCommand}" Appearance="Secondary"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="17,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="隐私与安全" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Cookie 只会发送到允许的网易云官方域名。只有勾选记住登录时，才会使用 Windows DPAPI（CurrentUser）加密保存；退出登录会删除 session.dat。"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" LineHeight="19" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Source="/NeteaseMusicCloudMatch.App;component/Assets/AppIcon.png"
                           Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NeteaseMusicCloudMatch" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="8,2" Margin="10,1,0,0">
                                <TextBlock Text="{Binding Version, StringFormat=版本 {0}}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="用于纠正当前用户自己网易云音乐云盘歌曲与网易云曲库歌曲 ID 的关联。"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock Text="非网易云音乐官方软件，不提供下载、VIP 破解或版权限制绕过功能。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开源致谢" FontWeight="SemiBold" />
                            <TextBlock Text="原始 Windows 项目：wuhenge/NeteaseMusicCloudMatch"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" />
                            <TextBlock Text="macOS 参考实现：joeyee233/NetEaseMusicCloudMatch"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <ui:Button Content="原项目" Command="{Binding OpenOriginalProjectCommand}" Appearance="Transparent" />
                            <ui:Button Content="Mac 参考" Command="{Binding OpenMacReferenceCommand}" Appearance="Transparent" Margin="4,0,0,0" />
                            <ui:Button Content="WPF-UI" Command="{Binding OpenWpfUiCommand}" Appearance="Transparent" Margin="4,0,0,0" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
